# Google AI Studio injects GEMINI_API_KEY into the server automatically.
# Keep this line commented in AI Studio so it does not replace the managed
# account key with an empty environment-variable prompt.
# GEMINI_API_KEY=

# Optional: enables OpenAI image models only on external deployments.
# OPENAI_API_KEY=

# Optional external-hosting settings.
# PORT=3000
# REDIS_URL=redis://localhost:6379
