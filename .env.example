# Google AI Studio injects GEMINI_API_KEY into the server automatically.
# Outside AI Studio, leave it empty to enable per-user BYOK mode.
# GEMINI_API_KEY=

# Optional: enables OpenAI image models for every user of this deployment.
# OPENAI_API_KEY=

# Optional runtime overrides for external deployments. Keep these commented in
# Google AI Studio so Build mode does not treat them as required secrets.
# PORT=3000
# MAX_BATCH_CONCURRENCY=2
# API_RATE_LIMIT_MAX=40
# REQUEST_BODY_LIMIT=75mb
# REDIS_URL=redis://localhost:6379
