{
  "name": "vanish-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test GEMINI_API_KEY= OPENAI_API_KEY= node --import tsx --test server/*.test.ts server/**/*.test.ts src/**/*.test.ts",
    "verify:bundle": "node scripts/verify-client-bundle.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "check": "npm run lint && npm test && npm run verify:architecture && npm run build && npm run verify:bundle",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^12.43.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "konva": "^10.3.2",
    "lucide-react": "^0.546.0",
    "multer": "^2.3.0",
    "openai": "^6.49.0",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.1.2",
    "react-konva": "^19.2.5",
    "redis": "^6.2.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^13.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "vite": "^6.4.3"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "protobufjs": "^7.6.6",
    "qs": "^6.15.3",
    "ws": "^8.21.3"
  }
}
